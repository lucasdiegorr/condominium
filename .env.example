# PostgreSQL (docker-compose) — the backend builds DATABASE_URL from these
# components, so POSTGRES_PASSWORD may contain special characters (%, @, :, ...)
POSTGRES_USER=cond
POSTGRES_PASSWORD=cond_pass
POSTGRES_DB=condominium

# Backend
# Optional override: when set, DATABASE_URL takes precedence over the
# POSTGRES_* components above.
# DATABASE_URL=postgresql+asyncpg://cond:cond_pass@postgres:5432/condominium
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
IDENTITY_TOKEN_TTL_MINUTES=60
SCOPED_TOKEN_TTL_MINUTES=20

# Seed (first run)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456

# Frontend
VITE_API_BASE_URL=/api
